{
  "name": "Frontier",
  "dataColors": [
    "#0072B2",
    "#D55E00",
    "#009E73",
    "#E69F00",
    "#56B4E9",
    "#CC79A7",
    "#4A5568",
    "#333F48",
    "#999999",
    "#F0E442",
    "#005CAB",
    "#B84E00"
  ],
  "background": "#FFFFFF",
  "foreground": "#1E293B",
  "tableAccent": "#0072B2",
  "good": "#0072B2",
  "neutral": "#E69F00",
  "bad": "#D55E00",
  "maximum": "#0072B2",
  "center": "#E69F00",
  "minimum": "#D55E00",
  "null": "#94A3B8",
  "hyperlink": "#0072B2",
  "visitedHyperlink": "#56B4E9",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI",
      "color": "#1E293B"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "color": "#1E293B"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "color": "#1E293B"
    },
    "label": {
      "fontFace": "Segoe UI",
      "color": "#64748B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "foregroundColor": {
              "solid": {
                "color": "#1E293B"
              }
            }
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "gridHorizontalWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "autoSizeColumnWidth": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}