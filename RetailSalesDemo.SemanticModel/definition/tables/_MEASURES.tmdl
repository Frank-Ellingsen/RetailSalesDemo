table _MEASURES
	lineageTag: 92eb0c16-5695-449a-8f38-aa57160a82bb

	measure 'Total Cost' = SUM(FactSales[Cost])
		formatString: #,0
		displayFolder: Costs
		lineageTag: c4cd68ad-cec7-464d-b9a3-4e22a00402ab

	measure 'Total Revenue' =
			
			SUM(FactSales[Revenue])
		formatString: #,0
		displayFolder: Revenue
		lineageTag: 0f612c30-64ea-4a82-8f48-0a6fdb6b09ae

	measure 'Total Profit' =
			
			[Total Revenue] - [Total Cost]
		formatString: #,0;(#,0);"-"
		displayFolder: Profitability
		lineageTag: 05c29dbd-b6a1-4341-ab81-2de6e8dd5e89

	measure 'Units Sold' =
			
			SUM ( FactSales[UnitsSold] )
		lineageTag: 9314437e-c79d-4da2-8ab6-9fa53f450fce

	measure 'Revenue YTD' = TOTALYTD([Total Revenue],DimDate[Date])
		displayFolder: Time Intelligence
		lineageTag: cc325d8a-aa4e-45f5-90d1-78534f56d1d5

	measure 'Revenue MTD' = TOTALMTD([Total Revenue],DimDate[Date])
		displayFolder: Time Intelligence
		lineageTag: b2832a5d-c23b-4603-acdc-551d94078fda

	measure 'Revenue QTD' = TOTALQTD([Total Revenue],DimDate[Date])
		displayFolder: Time Intelligence
		lineageTag: efc7f0f7-fdfc-4674-8c3d-f4179194cdf3

	measure 'Revenue Previous Month' = CALCULATE([Total Revenue],DATEADD(DimDate[Date],-1,MONTH))
		displayFolder: Time Intelligence
		lineageTag: b59e5920-1a82-46a8-9701-962b14c26058

	measure 'Revenue Previous Day' = CALCULATE([Total Revenue],DATEADD(DimDate[Date],-1,DAY))
		displayFolder: Time Intelligence
		lineageTag: 1050a14d-c2b8-441a-8591-a36e8f2b5688

	measure 'Total Units' = SUM(FactSales[UnitsSold])
		formatString: #,0
		displayFolder: Operations
		lineageTag: b5a5444e-2660-4e80-b0df-354d7ea68479

	measure 'Transaction Count' = COUNTROWS(FactSales)
		formatString: #,0
		displayFolder: Operations
		lineageTag: b619977d-adaa-4f15-8519-8b5d420cb5d5

	measure 'Revenue Per Unit' = DIVIDE([Total Revenue],[Total Units])
		formatString: #,0.00
		displayFolder: Revenue
		lineageTag: 7f274680-5f98-4a82-ae01-44d6e055dd2a

	measure '% of Total Revenue' = DIVIDE([Total Revenue],CALCULATE([Total Revenue],ALL(DimProduct)))
		formatString: 0.00%
		displayFolder: Analysis
		lineageTag: ee745474-6214-4161-9047-72a3d127c23f

	measure 'Loss-Making Revenue' = CALCULATE([Total Revenue],FactSales[Cost] > FactSales[Revenue])
		formatString: #,0
		displayFolder: Analysis
		lineageTag: 28da919f-83d9-4de4-a1ab-cbdec63b4fe7

	measure 'Loss-Making Transactions' = CALCULATE(COUNTROWS(FactSales),FactSales[Cost] > FactSales[Revenue])
		formatString: #,0
		displayFolder: Analysis
		lineageTag: 66dbade4-87c4-44a1-93c2-7b947cbfde5a

	measure 'Profitable Sales %' = DIVIDE(CALCULATE(COUNTROWS(FactSales),FactSales[Revenue] > FactSales[Cost]),COUNTROWS(FactSales))
		formatString: 0.00%
		displayFolder: Analysis
		lineageTag: bc465f3c-537b-4df6-8332-e01a52f98344

	measure 'Total Revenue 1' = SUM(FactSales[Revenue])
		formatString: #,0
		displayFolder: Revenue
		lineageTag: f8ef5b3d-791b-4073-9479-ebb64e19ef0e

	measure 'Total Units 1' = SUM(FactSales[UnitsSold])
		formatString: #,0
		displayFolder: Operations
		lineageTag: 8d34d4ca-d72e-4f86-9a19-de8422941786

	measure Profit = [Total Revenue]-[Total Cost]
		formatString: #,0;(#,0);"-"
		displayFolder: Profitability
		lineageTag: 63a9bb27-f0b5-451e-b260-35e9a6117fec

	measure 'Profit Margin %' = DIVIDE([Profit],[Total Revenue])
		formatString: 0.0%
		displayFolder: Profitability
		lineageTag: caab54d1-4343-4908-9c17-01671f4dd441

	measure Customers = DISTINCTCOUNT(FactSales[CustomerKey])
		formatString: #,0
		displayFolder: Customers
		lineageTag: a0a2dcfd-aac3-463a-a8df-c64080c3527c

	measure 'Revenue Per Customer' = DIVIDE([Total Revenue],[Customers])
		formatString: #,0.00
		displayFolder: Customers
		lineageTag: 5a56e185-ddf2-4834-bcde-cbe490c501bc

	measure 'Revenue YTD 1' = TOTALYTD([Total Revenue],DimDate[Date])
		displayFolder: Time Intelligence
		lineageTag: e1f5024f-d748-4bb2-a862-f649c8bdea0e

	measure 'Revenue MTD 1' = TOTALMTD([Total Revenue],DimDate[Date])
		displayFolder: Time Intelligence
		lineageTag: 4c35142f-eb2d-4da4-b30a-f72f4e86c018

	measure '% of Total Revenue 1' = DIVIDE([Total Revenue],CALCULATE([Total Revenue],ALL(DimProduct)))
		displayFolder: Analysis
		lineageTag: 61fdebfd-7abd-4da4-a05f-6e794cd2dfa0

	measure 'Selected Product' = SELECTEDVALUE(DimProduct[ProductName], "Multiple Products")
		displayFolder: Selections
		lineageTag: e226d6a8-78cc-474d-9d5c-52d9d378b4c7

	measure 'Selected Segment' = SELECTEDVALUE(DimCustomer[Segment], "All Segments")
		displayFolder: Selections
		lineageTag: bf6f2790-1fce-4208-8e9d-f2b3ee9cc7ec

	measure 'Revenue Selected Product' = ```
			
			    VAR SelectedProduct =
			        SELECTEDVALUE(DimProduct[ProductName])
			    RETURN
			        IF(
			            NOT ISBLANK(SelectedProduct),
			            [Total Revenue]
			        )
			    
			```
		displayFolder: Analysis
		lineageTag: 71845c97-6284-4aa3-89d3-0f8af7a2e419

	measure 'Report Title' = ```
			
			    "Revenue for " &
			    SELECTEDVALUE(
			        DimRegion[RegionName],
			        "All Regions"
			    )
			    
			```
		displayFolder: Dynamic Titles
		lineageTag: 151d066f-76ad-47c1-88a6-debad980d499

	measure 'Selected Product Profit' = ```
			
			    VAR ProductName =
			        SELECTEDVALUE(DimProduct[ProductName])
			    RETURN
			        IF(
			            NOT ISBLANK(ProductName),
			            [Profit]
			        )
			    
			```
		displayFolder: Analysis
		lineageTag: 6a34b487-1f78-4084-bca3-bbda3d3f00d2

	measure 'Single Product Selected' = ```
			
			    IF(
			        HASONEVALUE(DimProduct[ProductName]),
			        1,
			        0
			    )
			    
			```
		displayFolder: Selections
		lineageTag: 35c06b7f-a92d-4649-894e-07fda379b6ec

	measure 'KPI Message' = ```
			
			    VAR Margin = [Profit Margin %]
			    RETURN
			        SWITCH(
			            TRUE(),
			            Margin >= 0.40, "Excellent",
			            Margin >= 0.20, "Good",
			            Margin >= 0.10, "Average",
			            "Needs Attention"
			        )
			    
			```
		displayFolder: Dynamic Titles
		lineageTag: 8c17ccd1-f412-45d8-83d4-51819d971078

	measure 'Profitability Band' = ```
			
			    SWITCH(
			        TRUE(),
			        [Profit Margin %] < 0, "Loss",
			        [Profit Margin %] < 0.10, "Low Margin",
			        [Profit Margin %] < 0.25, "Medium Margin",
			        "High Margin"
			    )
			    
			```
		displayFolder: Profitability
		lineageTag: 532ebbd9-0016-4908-aa5f-2e7a54b0cf38

	measure 'Profitability Status' =
			VAR Margin = [Profit Margin %]
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(Margin), "-",
					Margin < 0, "▲ Loss Risk (<0%)",
					Margin < 0.20, "◆ Moderate (0-20%)",
					"● Strong (>=20%)"
				)
		displayFolder: Profitability
		lineageTag: 48f9d0c2-7102-4753-9a3b-18a7c2936d91

	measure 'Cost Per Unit' = DIVIDE([Total Cost], [Total Units])
		formatString: #,0.00
		displayFolder: Costs
		lineageTag: a3f81e22-817a-4c19-918d-f9e283741a01

	measure 'Average Order Value' = DIVIDE([Total Revenue], [Transaction Count])
		formatString: #,0.00
		displayFolder: Operations
		lineageTag: b4c92f33-928b-4d2a-a29e-0af394852b12

	measure 'Profit Per Customer' = DIVIDE([Total Profit], [Customers])
		formatString: #,0.00
		displayFolder: Customers
		lineageTag: c5da3e44-039c-4e3b-b3af-1ba405963c23

	measure 'Loss-Making Transactions %' = DIVIDE([Loss-Making Transactions], [Transaction Count])
		formatString: 0.0%
		displayFolder: Analysis
		lineageTag: d6eb4f55-14ad-4f4c-c4ba-2cb516074d34

	measure 'Gross Value of Loss' = CALCULATE(SUMX(FactSales, FactSales[Cost] - FactSales[Revenue]), FactSales[Cost] > FactSales[Revenue])
		formatString: #,0
		displayFolder: Analysis
		lineageTag: e7fc5a66-25be-405d-d5cb-3dc627185e45

	measure 'Revenue Running Total' =
			CALCULATE(
				[Total Revenue],
				FILTER(
					ALLSELECTED(DimDate[Date]),
					DimDate[Date] <= MAX(DimDate[Date])
				)
			)
		formatString: #,0
		displayFolder: Time Intelligence
		lineageTag: f1a2b3c4-d5e6-47a8-b9c0-1d2e3f4a5b6c

	measure 'Cost Running Total' =
			CALCULATE(
				[Total Cost],
				FILTER(
					ALLSELECTED(DimDate[Date]),
					DimDate[Date] <= MAX(DimDate[Date])
				)
			)
		formatString: #,0
		displayFolder: Time Intelligence
		lineageTag: a2b3c4d5-e6f7-48a9-b0c1-2d3e4f5a6b7d

	measure 'Profit Running Total' = [Revenue Running Total] - [Cost Running Total]
		formatString: #,0;(#,0);"-"
		displayFolder: Time Intelligence
		lineageTag: b3c4d5e6-f7a8-49b0-c1d2-3e4f5a6b7c8e

	measure 'Revenue MoM Variance' =
			VAR PrevMonth = [Revenue Previous Month]
			RETURN
				IF(
					NOT ISBLANK(PrevMonth) && NOT ISBLANK([Total Revenue]),
					[Total Revenue] - PrevMonth
				)
		formatString: #,0;(#,0);"-"
		displayFolder: Time Intelligence
		lineageTag: c4d5e6f7-a8b9-40c1-d2e3-4f5a6b7c8d9f

	measure 'Revenue MoM %' = DIVIDE([Revenue MoM Variance], [Revenue Previous Month])
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: d5e6f7a8-b9c0-41d2-e3f4-5a6b7c8d9e0a

	measure 'Commercial Risk Indicator' =
			VAR LossRatio = [Loss-Making Transactions %]
			RETURN
				SWITCH(
					TRUE(),
					LossRatio = 0, "● Low Risk (0%)",
					LossRatio <= 0.15, "◆ Moderate (<=15%)",
					"▲ Elevated Risk (>15%)"
				)
		displayFolder: Analysis
		lineageTag: f8ad6b77-36cf-416e-e6dc-4ed738296f56

	measure 'Revenue 30D Moving Avg' =
			AVERAGEX(
				DATESINPERIOD(DimDate[Date], MAX(DimDate[Date]), -30, DAY),
				[Total Revenue]
			)
		formatString: #,0
		displayFolder: Time Intelligence
		lineageTag: e8a9b0c1-d2e3-4f5a-6b7c-8d9e0f1a2b3c

	measure 'Revenue Difference vs First' =
			VAR FirstDate = CALCULATE(MIN(DimDate[Date]), ALLSELECTED(DimDate))
			VAR FirstRevenue = CALCULATE([Total Revenue], DimDate[Date] = FirstDate)
			RETURN
				IF(NOT ISBLANK([Total Revenue]), [Total Revenue] - FirstRevenue)
		formatString: #,0;(#,0);"-"
		displayFolder: Time Intelligence
		lineageTag: f9b0c1d2-e3f4-4a5b-6c7d-8e9f0a1b2c3d

	measure 'Revenue % Difference vs First' =
			VAR FirstDate = CALCULATE(MIN(DimDate[Date]), ALLSELECTED(DimDate))
			VAR FirstRevenue = CALCULATE([Total Revenue], DimDate[Date] = FirstDate)
			RETURN
				DIVIDE([Total Revenue] - FirstRevenue, FirstRevenue)
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: a0c1d2e3-f4a5-4b6c-7d8e-9f0a1b2c3d4e

	measure 'Revenue Variance to Overall Avg' =
			VAR OverallAvg = CALCULATE(AVERAGEX(VALUES(DimDate[Date]), [Total Revenue]), ALLSELECTED(DimDate))
			RETURN
				IF(NOT ISBLANK([Total Revenue]), [Total Revenue] - OverallAvg)
		formatString: #,0;(#,0);"-"
		displayFolder: Time Intelligence
		lineageTag: b1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e5f

	measure 'Negative Cost' = -[Total Cost]
		formatString: #,0;(#,0);"-"
		displayFolder: Costs
		lineageTag: c2e3f4a5-b6c7-4d8e-9f0a-1b2c3d4e5f6a

	measure 'Product Rank' = RANKX(ALL(DimProduct[ProductName]), [Total Revenue], , DESC, DENSE)
		formatString: 0
		displayFolder: Analysis
		lineageTag: d3f4a5b6-c7d8-4e9f-0a1b-2c3d4e5f6a7b

	column Value
		formatString: 0
		lineageTag: 8ae0404e-dffa-48df-9802-1d7a7d3f58df
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _MEASURES = calculated
		mode: import
		source = {BLANK()}

	annotation PBI_Id = 99fa2c059a414a57a5ba733d84e8e86c

